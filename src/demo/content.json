s":[30,45,60,75,90]},"duration_sec":197,"scoring":{"method":"per_stage","points":25,"points_by_stage":[30,45,60,75,90]},"attempts_limit":1,"settings":{"sequential":true,"eliminate_on_fail":true,"instant_feedback":true,"memory":{"intro_ms":2500,"show_ms":3500,"recall_ms":15000,"result_ms":4000}},"assets":[],"submission_policy":"captain_only"},{"id":"demo-truth","kind":"truth_or_fiction","title":"האמת או ההמצאה?","instructions":"בכל סט ארבע עובדות: שלוש אמיתיות ואחת מומצאת. מצאו את המומצאת.","public_content":{"items":[{"facts":["בחנוכה אומרים הלל שלם בכל שמונת ימי החג.","סיפור נס פך השמן מופיע בתלמוד הבבלי, במסכת שבת.","ספרי המקבים נכללים בתנ\"ך העברי, בחלק הכתובים.","חנוכה הוא החג היחיד בלוח העברי שנמשך על פני שני חודשים: כסלו וטבת."]},{"facts":["המשחק בסביבון בחנוכה מוזכר במפורש בתלמוד.","ביידיש הסביבון נקרא \"דריידל\".","על סביבונים בארץ ישראל מופיעה האות פ׳: \"נס גדול היה פה\".","הלביבות המסורתיות של יהודי מזרח אירופה עשויות בעיקר מתפוחי אדמה."]},{"facts":["בית המקדש נחנך מחדש בכ\"ה בכסלו.","יהודה המכבי היה אחד מבניו של מתתיהו.","לפי אחד ההסברים, הכינוי \"מכבי\" בא מהמילה \"מקבת\", שפירושה פטיש.","יהודה המכבי נהרג בקרב על חומות ירושלים, ביום חנוכת המקדש."]}]},"duration_sec":120,"scoring":{"method":"per_item","points":100},"attempts_limit":1,"settings":{},"assets":[],"submission_policy":"captain_only"},{"id":"demo-order","kind":"ordering","title":"הסדר הנכון","instructions":"סדרו את האירועים לפי סדר הזמנים, מהמוקדם (למעלה) למאוחר (למטה). יש ניקוד חלקי על כל זוג שסידרתם נכון.","public_content":{"items":[{"id":"e","label":"טיהור המקדש וחנוכת המזבח"},{"id":"b","label":"מתתיהו פותח במרד במודיעין"},{"id":"f","label":"יהודה המכבי נופל בקרב"},{"id":"a","label":"אנטיוכוס גוזר גזירות על היהודים"},{"id":"d","label":"המכבים משחררים את ירושלים"},{"id":"c","label":"מתתיהו מת, ויהודה עומד בראש המורדים"}]},"duration_sec":120,"scoring":{"method":"partial","points":300},"attempts_limit":1,"settings":{},"assets":[],"submission_policy":"captain_only"},{"id":"demo-slide","kind":"slidi